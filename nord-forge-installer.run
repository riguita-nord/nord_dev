#!/usr/bin/env bash
set -Eeuo pipefail
umask 027

TRUSTED_REPO="riguita-nord/nord_dev"
CONFIG="/etc/nord-forge/update.conf"
MODE="${1:-install}"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOCK="/run/nord-forge-updater.lock"

log(){ printf '[Nord Forge Launcher] %s\n' "$*"; }
die(){ printf '[Nord Forge Launcher] ERROR: %s\n' "$*" >&2; exit 1; }
require_root(){ [[ ${EUID:-$(id -u)} -eq 0 ]] || die "Run with sudo."; }

auth_header(){
  local token="${NORD_GITHUB_TOKEN:-}"
  [[ -z "$token" && -f "$CONFIG" ]] && token="$(awk -F= '$1=="NORD_GITHUB_TOKEN"{v=substr($0,index($0,"=")+1)} END{print v}' "$CONFIG" 2>/dev/null || true)"
  [[ -n "$token" ]] && printf '%s' "Authorization: Bearer $token" || true
}

bootstrap(){
  local action="$1" tmp archive src ref_json sha branch version ah
  tmp="$(mktemp -d /tmp/nord-forge-launcher.XXXXXX)"
  trap 'rm -rf -- "$tmp"' RETURN
  archive="$tmp/source.tar.gz"; src="$tmp/source"; ref_json="$tmp/ref.json"
  branch="main"; ah="$(auth_header)"

  log "Resolving trusted commit from ${TRUSTED_REPO}:${branch}..."
  if [[ -n "$ah" ]]; then
    curl -fsSL --retry 2 -H 'Accept: application/vnd.github+json' -H "$ah" "https://api.github.com/repos/${TRUSTED_REPO}/commits/${branch}" -o "$ref_json"
  else
    curl -fsSL --retry 2 -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/${TRUSTED_REPO}/commits/${branch}" -o "$ref_json"
  fi
  sha="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["sha"])' "$ref_json")"
  [[ "$sha" =~ ^[0-9a-fA-F]{40}$ ]] || die "Invalid GitHub commit SHA."
  log "Pinned commit ${sha:0:12}."

  if [[ -n "$ah" ]]; then
    curl -fsSL --retry 2 -H "$ah" "https://api.github.com/repos/${TRUSTED_REPO}/tarball/${sha}" -o "$archive"
  else
    curl -fsSL --retry 2 "https://api.github.com/repos/${TRUSTED_REPO}/tarball/${sha}" -o "$archive"
  fi
  mkdir -p "$src"; tar -xzf "$archive" -C "$src" --strip-components=1
  [[ -f "$src/VERSION" && -f "$src/install.sh" && -f "$src/core/pom.xml" && -f "$src/admin-service/pom.xml" ]] || die "Downloaded source is not Nord Forge V2."
  version="$(tr -d '[:space:]' < "$src/VERSION")"
  log "Verified Nord Forge V${version}."
  NORD_UPDATE_SOURCE_SHA="$sha" bash "$src/install.sh" "$action"
}

case "$MODE" in
  install)
    require_root
    if [[ -f "$SELF_DIR/install.sh" && -f "$SELF_DIR/VERSION" ]]; then exec bash "$SELF_DIR/install.sh" install; fi
    bootstrap install
    ;;
  update)
    require_root
    exec 9>"$LOCK"; flock -n 9 || die "Another update is running."
    bootstrap update
    ;;
  uninstall)
    require_root
    if [[ -f "$SELF_DIR/install.sh" ]]; then exec bash "$SELF_DIR/install.sh" uninstall; fi
    bootstrap uninstall
    ;;
  version|--version|-V) cat "$SELF_DIR/VERSION" 2>/dev/null || echo "Nord Forge V2";;
  *) die "Usage: $0 [install|update|uninstall|version]";;
esac
