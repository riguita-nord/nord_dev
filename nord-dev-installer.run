#!/usr/bin/env bash
set -Eeuo pipefail

# Legacy Nord Dev -> Nord Forge V2 migration entrypoint.
# install/update/replace ALWAYS fetch the current trusted Forge V2 launcher from GitHub.
# This deliberately ignores stale local nord-forge-installer.run files left by older builds.
MODE="${1:-update}"

case "$MODE" in
  install|update|replace)
    TARGET_MODE="replace"
    ;;
  version|--version|-V)
    TARGET_MODE="version"
    ;;
  uninstall)
    TARGET_MODE="uninstall"
    ;;
  *)
    echo "Usage: $0 [install|update|replace|uninstall|version]" >&2
    exit 2
    ;;
esac

TMP="$(mktemp /tmp/nord-forge-installer.XXXXXX.run)"
cleanup(){ rm -f "$TMP"; }
trap cleanup EXIT

curl -fsSL --retry 2 \
  "https://raw.githubusercontent.com/riguita-nord/nord_dev/main/nord-forge-installer.run" \
  -o "$TMP"
chmod 0755 "$TMP"

exec "$TMP" "$TARGET_MODE"
